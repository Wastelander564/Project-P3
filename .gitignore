# ===============
# Unity.gitignore
# ===============

# Unity-generated folders (DO NOT TRACK)
Library/
Logs/
Temp/
Obj/
Build/
Builds/
UserSettings/

# Visual Studio / JetBrains Rider project files
.vs/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.unityproj
*.db
*.opendb

# Unity Package Manager cache
Packages/manifest.json
Packages/packages-lock.json

# Auto-generated by Unity
ProjectSettings/ProjectVersion.txt

# Ignore crash reports, Unity locks, and local settings
CrashReports/
MemoryCaptures/

# Git Large File Storage (LFS) tracking for large assets
*.psd
*.tga
*.fbx
*.mp4
*.wav
*.dll
*.dylib

# Ignore PlayMode and Editor settings
*.pidb
*.tmp
*.bak
*.swp

# Rider logs
.idea/
*.iml
